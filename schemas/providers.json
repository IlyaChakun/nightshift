{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ilyachakun/nightshift/schemas/providers.json",
  "title": "Providers",
  "description": "providers.yaml of an instance: provider = harness + way to pay (design section 12). Every key except pools is a provider name.",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["monthly_usd"],
        "properties": {
          "monthly_usd": { "type": ["number", "null"], "minimum": 0 },
          "caps": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
        }
      }
    }
  },
  "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
  "additionalProperties": {
    "type": "object", "additionalProperties": false, "required": ["harness", "auth"],
    "properties": {
      "harness": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "auth": { "enum": ["subscription", "api_key", "org_api_key", "copilot_token", "chatgpt"] },
      "key_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "model": { "type": "string", "minLength": 1 },
      "base_url": { "type": "string", "pattern": "^https://", "description": "OpenAI-compatible endpoint for the codex harness, for example DeepSeek; its host must be on the egress allowlist." },
      "price": {
        "type": "object", "additionalProperties": false, "required": ["input_per_mtok", "output_per_mtok"],
        "description": "Dollars per million tokens. Used only when the harness reports no cost, so a pool budget sees the spend of codex.",
        "properties": { "input_per_mtok": { "type": "number", "minimum": 0 }, "output_per_mtok": { "type": "number", "minimum": 0 } }
      },
      "pool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "concurrency": { "type": "integer", "minimum": 1 },
      "tier": { "enum": ["primary", "fallback"], "description": "A fallback provider runs a task only when every primary one of the role is at a limit that resets later than the tenant's on_limit.max_wait, and the task or the tenant allows it (design section 12). Lead never uses one." },
      "weekly_share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
      "batch": { "enum": ["allowed", "forbidden"] }
    },
    "allOf": [
      {
        "$comment": "The subscription runs one session at a time, like one developer (design section 12).",
        "if": { "properties": { "auth": { "const": "subscription" } } },
        "then": { "required": ["concurrency"], "properties": { "concurrency": { "const": 1 }, "batch": { "const": "forbidden" } } }
      }
    ]
  }
}
