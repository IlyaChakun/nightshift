{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ilyachakun/nightshift/schemas/spec.json",
  "title": "Spec",
  "description": "Lead's Definition of Ready: goal, criteria, scope, tags, tasks and dependencies (design section 6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "goal", "prd_path", "acceptance_criteria", "tasks"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 600 },
    "prd_path": { "type": "string", "minLength": 1 },
    "adr_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 },
          "source_quote": { "type": "string", "minLength": 1, "maxLength": 300, "description": "The owner's own words this criterion rests on, copied from an owner message of the task. Leave it out for a criterion Lead added itself; the card then marks it as Lead's addition." }
        }
      }
    },
    "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blast_radius_tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "repo": { "type": "string", "pattern": "^[a-z0-9.-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^T-[0-9]+$" } }
        }
      }
    }
  }
}
