{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ilyachakun/nightshift/schemas/lead-reply.json",
  "title": "Lead reply",
  "description": "One chat message from Lead; four message types of up to 60 words (design section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "text"],
  "properties": {
    "type": { "enum": ["question", "decision_needed", "ready_for_acceptance", "blocker_or_summary"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 600 },
    "language": { "type": "string", "pattern": "^[a-z]{2}$", "description": "Language of the owner's message; artifacts stay in English." },
    "options": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label"],
        "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "consequence": { "type": "string", "maxLength": 200 } }
      }
    },
    "recommended": { "type": "integer", "minimum": 0, "maximum": 2 },
    "handoff": { "$ref": "handoff.json" },
    "citations": {
      "description": "Past decisions quoted instead of asking again.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "quote", "date"],
        "properties": { "source": { "type": "string" }, "quote": { "type": "string" }, "date": { "type": "string", "format": "date" } }
      }
    },
    "spec_ready": { "type": "boolean", "description": "true when `spec` carries the finished spec; the owner then gets it with Approve, Edit and Reject." },
    "spec": { "$ref": "spec.json" }
  },
  "if": { "properties": { "type": { "const": "question" } } },
  "then": { "required": ["options", "recommended"] },
  "allOf": [
    { "if": { "properties": { "spec_ready": { "const": true } }, "required": ["spec_ready"] }, "then": { "required": ["spec"] } }
  ]
}
