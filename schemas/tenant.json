{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ilyachakun/nightshift/schemas/tenant.json",
  "title": "Tenant",
  "description": "tenants/<name>/tenant.yaml: one project inside an instance (design section 17).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "governance", "data_classification", "repos", "people", "chat", "tracker", "docs", "providers", "review", "schedule"],
  "properties": {
    "name": { "$ref": "#/$defs/slug" },
    "governance": { "enum": ["solo", "team"] },
    "data_classification": { "enum": ["public", "internal", "confidential", "pci"] },
    "repos": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
    },
    "people": {
      "type": "object", "additionalProperties": false, "required": ["owner", "approvers"],
      "properties": {
        "owner": {
          "type": "object", "additionalProperties": false, "required": ["github"],
          "properties": { "chat": { "type": "string" }, "github": { "type": "string", "minLength": 1 } }
        },
        "approvers": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "pattern": "^(owner|github:[A-Za-z0-9-]+|github-team:[A-Za-z0-9-]+/[A-Za-z0-9_.-]+|codeowners)$" }
        }
      }
    },
    "chat": { "$ref": "#/$defs/adapter" },
    "tracker": { "$ref": "#/$defs/adapter" },
    "docs": { "$ref": "#/$defs/adapter" },
    "providers": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } }
    },
    "on_limit": {
      "description": "What the factory does when a model provider is at its limit (design section 12, ADR 0009). Without it a task waits for a reset of up to 2 hours and uses a fallback provider for longer ones only when the task opts in.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_wait": { "type": "string", "pattern": "^[0-9]+(m|h)$", "description": "Longest reset to wait for before a fallback provider is used, for example 90m or 2h." },
        "fallback": { "enum": ["never", "per_task", "always"], "description": "never: wait for the reset; per_task: only tasks queued with --allow-fallback; always: every task except Lead's." }
      }
    },
    "mcp": {
      "description": "The remote MCP door for a claude.ai project (design section 15). Off when absent.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "remote": {
          "type": "object", "additionalProperties": false, "required": ["listen"],
          "properties": { "listen": { "type": "string", "pattern": "^(127\\.0\\.0\\.1|localhost):[0-9]{2,5}$", "description": "Loopback address and port; the person exposes it with a tunnel." } }
        }
      }
    },
    "capacity": {
      "type": "object", "additionalProperties": false,
      "properties": { "tasks": { "type": "integer", "minimum": 1 }, "previews": { "type": "integer", "minimum": 0 }, "preview_hours": { "type": "integer", "minimum": 1, "maximum": 8760 } }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": { "cpus": { "type": "number", "exclusiveMinimum": 0 }, "memory": { "type": "string", "pattern": "^[0-9]+[mg]$" } }
    },
    "roles": {
      "description": "Model and effort per role, over the role's own (design section 12).",
      "type": "object", "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": { "model": { "$ref": "#/$defs/models" }, "effort": { "$ref": "#/$defs/effort" } }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "run": {
          "description": "Limits of one agent run, overriding the role's own (ADR 0019). A key that is absent keeps the role's value.",
          "type": "object", "additionalProperties": false,
          "properties": {
        "minutes": { "type": "integer", "minimum": 1 },
        "tokens": { "type": "integer", "minimum": 1 },
        "stall_minutes": { "type": "integer", "minimum": 0, "description": "No output for this long stops the run; 0 switches the rule off." },
        "repeat_limit": { "type": "integer", "minimum": 0, "description": "The same tool call this many times in a row stops the run; 0 switches the rule off." },
        "cost_usd": { "type": "number", "minimum": 0, "description": "Dollars one run may spend; 0 means no cap." }
          }
        },
        "task": {
          "type": "object", "additionalProperties": false, "required": ["iterations", "tokens", "hours"],
          "properties": {
            "iterations": { "type": "integer", "minimum": 1 },
            "tokens": { "type": "integer", "minimum": 1 },
            "hours": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": { "enum": ["all", "blast_radius", "off"] },
        "actions": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "low": { "$ref": "#/$defs/action" },
            "medium": { "$ref": "#/$defs/action" },
            "high": { "$ref": "#/$defs/action" },
            "critical": { "const": "review_design_and_pr" }
          }
        },
        "sample": { "type": "number", "minimum": 0, "maximum": 1 },
        "remind_after_hours": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "sla_automerge_hours": { "type": "integer", "minimum": 1 }
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["timezone"],
      "properties": {
        "timezone": { "type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$" },
        "quiet_hours": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "releases_in_quiet_hours": { "type": "boolean" },
        "morning_summary": { "$ref": "#/$defs/clock" }
      }
    },
    "language": {
      "type": "object", "additionalProperties": false,
      "properties": { "artifacts": { "const": "en" }, "chat": { "type": "string", "pattern": "^(auto|[a-z]{2})$" } }
    }
  },
  "allOf": [
    {
      "$comment": "team: the factory never merges on its own, so no off mode and no SLA auto-merge (design section 11).",
      "if": { "properties": { "governance": { "const": "team" } } },
      "then": {
        "properties": {
          "review": {
            "properties": { "mode": { "enum": ["all", "blast_radius"] } },
            "not": { "required": ["sla_automerge_hours"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "models": {
      "description": "Model per harness (claude, codex, ...). A full model id, never a CLI alias such as opus or sonnet, so a CLI update cannot change it. A provider's own model wins over it.",
      "type": "object", "propertyNames": { "enum": ["claude", "codex", "copilot", "api", "fake"] },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]*$", "not": { "enum": ["default", "best", "opus", "sonnet", "haiku", "fable", "opusplan", "opus[1m]", "sonnet[1m]", "fable[1m]"] } }
    },
    "effort": { "description": "Reasoning effort. claude runs a level the model lacks at the highest one below it; codex passes the level as it is.", "enum": ["low", "medium", "high", "xhigh", "max"] },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "clock": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "action": { "enum": ["auto", "notify", "review", "review_design_and_pr"] },
    "adapter": {
      "description": "Adapter name comes from a pack; the remaining fields belong to that adapter.",
      "type": "object", "required": ["adapter"],
      "properties": { "adapter": { "$ref": "#/$defs/slug" } }
    }
  }
}
