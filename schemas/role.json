{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ilyachakun/nightshift/schemas/role.json",
  "title": "Role",
  "description": "roles/<name>.yaml: a role is configuration (design section 6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "access", "output_schema", "limits"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "access": { "enum": ["read_only", "worktree"] },
    "skills": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" } },
    "output_schema": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.json$" },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["minutes", "tokens"],
      "properties": {
        "max_returns": { "type": "integer", "minimum": 0 },
        "minutes": { "type": "integer", "minimum": 1 },
        "tokens": { "type": "integer", "minimum": 1 },
        "stall_minutes": { "type": "integer", "minimum": 0 },
        "repeat_limit": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
