{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ilyachakun/nightshift/schemas/project.json",
  "title": "Project",
  "description": ".nightshift/project.yaml in the tenant repository (design section 17).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "stack", "verify", "capabilities", "blast_radius"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "stack": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "instructions": { "$ref": "#/$defs/paths" },
    "skills": { "$ref": "#/$defs/paths" },
    "protected": { "$ref": "#/$defs/paths" },
    "setup": { "type": "string", "minLength": 1, "description": "Installs dependencies before the agent starts, as the agent user, after mise installed the pinned toolchain (for example npm ci)." },
    "verify": { "type": "string", "minLength": 1 },
    "tests": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ci": { "type": ["string", "null"] },
        "external": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["kind"],
              "properties": { "kind": { "enum": ["manual", "runner"] }, "ask": { "type": "string" } }
            }
          ]
        }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["merge_train"],
      "properties": {
        "merge_train": { "type": "boolean" },
        "preview": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "up", "down"],
              "properties": { "kind": { "const": "script" }, "up": { "$ref": "#/$defs/command" }, "down": { "$ref": "#/$defs/command" } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "envs"],
              "properties": { "kind": { "const": "external" }, "envs": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
            }
          ]
        },
        "release": { "$ref": "#/$defs/optionalCommand" },
        "rollback": { "$ref": "#/$defs/optionalCommand" },
        "smoke": { "$ref": "#/$defs/optionalCommand" }
      }
    },
    "blast_radius": { "type": "string", "minLength": 1 },
    "docs": {
      "type": "object", "additionalProperties": false,
      "properties": { "adr": { "type": "string" }, "prd": { "type": "string" } }
    }
  },
  "$defs": {
    "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "command": { "type": "string", "minLength": 1 },
    "optionalCommand": { "type": ["string", "null"], "minLength": 1 }
  }
}
